/* pages/dish-form/dish-form.wxss */
.label { font-size: 27rpx; color: #8a7a6a; margin: 20rpx 0 12rpx; font-weight: 600; }
.label:first-child { margin-top: 4rpx; }
.input {
  background: #fff8f0; border-radius: 14rpx;
  padding: 22rpx 24rpx; font-size: 29rpx;
}
.area {
  width: 100%; min-height: 140rpx;
  background: #fff8f0; border-radius: 14rpx;
  padding: 22rpx 24rpx; font-size: 28rpx;
  box-sizing: border-box;
}
.chips { display: flex; flex-wrap: wrap; margin-top: 14rpx; }
.chip {
  padding: 10rpx 26rpx; margin: 0 12rpx 12rpx 0;
  background: #fff; border: 2rpx solid #f0e2d0;
  border-radius: 24rpx; font-size: 25rpx; color: #6a5a48;
}
.chip.on { background: #fff3e4; color: #d97b29; border-color: #f6b267; }

.img-grid { display: flex; flex-wrap: wrap; }
.img-box { width: 168rpx; height: 168rpx; margin: 0 14rpx 14rpx 0; position: relative; }
.pv { width: 100%; height: 100%; border-radius: 14rpx; background:#f5efe8; }
.del {
  position: absolute; top: -12rpx; right: -12rpx;
  width: 40rpx; height: 40rpx; border-radius: 50%;
  background: #d9534f; color: #fff; font-size: 28rpx;
  display: flex; align-items: center; justify-content: center;
}
.img-add {
  width: 168rpx; height: 168rpx;
  border: 3rpx dashed #e0d4c4; border-radius: 14rpx;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  color: #c0b0a0;
}
.plus { font-size: 52rpx; line-height: 1; }
.hint { font-size: 22rpx; margin-top: 8rpx; }

.save-area { margin: 36rpx 24rpx; padding-bottom: 40rpx; }
.save-btn { width: 100%; }