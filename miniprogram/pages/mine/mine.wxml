<view class="profile">
  <image class="avatar" src="{{avatar || '/images/avatar.png'}}" mode="aspectFill" />
  <view class="p-info">
    <view class="p-name">{{nickName}}</view>
    <view class="p-sub">{{isAdmin ? '✨ 家庭大厨 · 商家' : '🍽 尊贵的干饭人'}}</view>
  </view>
</view>

<view class="card menu-list">
  <view class="menu-item" bindtap="goAdmin">
    <text class="mi-icon">🛎️</text>
    <text class="mi-text">商家后台（我的专属）</text>
    <text class="mi-arrow">›</text>
  </view>
  <view class="menu-item" bindtap="goOrders">
    <text class="mi-icon">📋</text>
    <text class="mi-text">我的订单</text>
    <text class="mi-arrow">›</text>
  </view>
  <view class="menu-item" wx:if="{{!isAdmin}}" bindtap="becomeAdmin">
    <text class="mi-icon">👑</text>
    <text class="mi-text">授权我成为老板（首次授权专属）</text>
    <text class="mi-arrow">›</text>
  </view>
</view>

<view class="intro card">
  <view class="intro-title">关于「若若家庭厨房」</view>
  <view class="intro-text">若若家庭厨房 🍜 这是我们两个人的秘密小食堂。你可以在这里添加我们最爱吃的菜，配上照片；TA 点了什么，后台秒知道。</view>
</view>