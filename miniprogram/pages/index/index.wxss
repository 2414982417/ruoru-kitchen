/* pages/index/index.wxss */
.header {
  background: linear-gradient(150deg, #ffe8d0, #fff3e4);
  padding: 50rpx 36rpx 40rpx;
}
.header-title { font-size: 40rpx; font-weight: 800; color: #7a4a1f; }
.header-sub { font-size: 24rpx; color: #b08050; margin-top: 10rpx; }

.cat-wrap { padding: 8rpx 0 12rpx; }
.cats { white-space: nowrap; padding: 0 20rpx; }
.cat {
  display: inline-block;
  padding: 12rpx 30rpx;
  margin: 8rpx;
  background: #fff;
  border-radius: 30rpx;
  font-size: 26rpx;
  color: #6a5a48;
  border: 2rpx solid #f0e2d0;
}
.cat.active {
  background: linear-gradient(135deg, #f6a34f, #d97b29);
  color: #fff;
  border-color: transparent;
}

.dish { display: flex; padding: 20rpx; }
.dish-img {
  width: 170rpx; height: 170rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
  background: #f5efe8;
}
.dish-info { flex: 1; margin-left: 22rpx; display: flex; flex-direction: column; }
.dish-name { font-size: 32rpx; font-weight: 700; }
.dish-desc {
  font-size: 24rpx; color: #b0a090;
  margin-top: 8rpx; flex: 1;
  display: -webkit-box; -webkit-box-orient: vertical;
  -webkit-line-clamp: 2; overflow: hidden;
}
.dish-foot { display: flex; align-items: center; justify-content: space-between; margin-top: 10rpx; }
.dish-price { color: #d97b29; font-weight: 800; font-size: 34rpx; }
.add-btn {
  width: 56rpx; height: 56rpx;
  background: linear-gradient(135deg, #f6a34f, #d97b29);
  color: #fff; font-size: 40rpx;
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 6rpx 14rpx rgba(217,123,41,.35);
}

.cart-bar {
  position: fixed; left: 24rpx; right: 24rpx; bottom: 40rpx;
  background: linear-gradient(135deg, #6a4a2a, #4a3320);
  color: #fff; border-radius: 46rpx;
  padding: 22rpx 30rpx;
  display: flex; align-items: center; justify-content: space-between;
  box-shadow: 0 12rpx 30rpx rgba(0,0,0,.25);
}
.cart-emoji { font-size: 36rpx; margin-right: 12rpx; }
.cart-info { display: flex; align-items: center; font-size: 28rpx; }
.cart-go { font-size: 28rpx; font-weight: 700; }