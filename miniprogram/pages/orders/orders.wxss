/* pages/orders/orders.wxss */
.order-head { display: flex; align-items: center; justify-content: space-between; }
.order-no { font-size: 24rpx; color: #b0a090; }
.items { margin-top: 18rpx; }
.it-row {
  display: flex; align-items: center; padding: 10rpx 0;
  border-bottom: 1rpx dashed #f0e2d0; font-size: 28rpx;
}
.it-name { flex: 1; }
.it-count { color: #b0a090; margin-right: 30rpx; }
.it-price { color: #6a5a48; width: 110rpx; text-align: right; }
.order-note { font-size: 24rpx; color: #d97b29; margin-top: 14rpx; }
.order-foot { display: flex; justify-content: space-between; align-items: center; margin-top: 16rpx; }
.time { font-size: 22rpx; color: #b0a090; }
.order-total { font-size: 30rpx; font-weight: 800; color: #d97b29; }