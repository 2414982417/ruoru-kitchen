<view class="body">
  <view class="card item" wx:for="{{cart}}" wx:key="id">
    <image class="item-img" src="{{item.img || '/images/placeholder.png'}}" mode="aspectFill" />
    <view class="item-info">
      <view class="item-name">{{item.name}}</view>
      <view class="dish-price-inline">¥{{item.price}}</view>
      <view class="stepper">
        <view class="step" data-index="{{index}}" bindtap="onMinus">−</view>
        <text class="num">{{item.count}}</text>
        <view class="step" data-index="{{index}}" bindtap="onPlus">+</view>
      </view>
    </view>
  </view>

  <view wx:if="{{!cart.length}}" class="empty">
    <text class="big">🧺</text>
    还没有点单，去菜单看看吧
    <view class="btn-primary" style="margin-top:40rpx;width:320rpx;display:inline-block;" bindtap="goMenu">去选菜</view>
  </view>

  <view class="card note-box" wx:if="{{cart.length}}">
    <view class="section-title">备注</view>
    <textarea class="note-area" placeholder="写点什么，比如少辣、多米饭..." value="{{note}}" bindinput="onNote" maxlength="100" />
    <view class="note-bar"><text class="clear-btn" bindtap="clearAll">清空点单</text></view>
  </view>
</view>

<view class="footer" wx:if="{{cart.length}}">
  <view class="total">
    <text class="total-label">合计</text>
    <text class="total-price">¥{{totalPrice}}</text>
    <text style="margin-left:14rpx;font-size:24rpx;color:#b0a090">共{{totalCount}}件</text>
  </view>
  <view class="btn-primary submit-btn" bindtap="submit">提交订单</view>
</view>